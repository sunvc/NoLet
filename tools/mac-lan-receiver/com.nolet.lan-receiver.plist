<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nolet.lan-receiver</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/bin/NoLetLanReceiver</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/USER/Library/Logs/nolet-lan-receiver.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USER/Library/Logs/nolet-lan-receiver.log</string>
</dict>
</plist>
