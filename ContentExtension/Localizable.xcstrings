{
  "sourceLanguage": "en",
  "strings": {
    "[%@]分组静音成功": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] Muted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@]分组静音成功"
          }
        }
      }
    },
    "iCloud 服务暂时不可用，请稍后再试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 服务暂时不可用，请稍后再试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud service temporarily unavailable, please try again later."
          }
        }
      }
    },
    "iCloud 访问受限，可能由家长控制或 MDM 设备管理策略导致": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 访问受限，可能由家长控制或 MDM 设备管理策略导致"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud access is restricted, possibly due to parental controls or MDM device management policies."
          }
        }
      }
    },
    "iCloud 账户可用": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账户可用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Account Available"
          }
        }
      }
    },
    "保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "保存图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存图片"
          }
        }
      }
    },
