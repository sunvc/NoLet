      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 iCloud，请登录 iCloud 账户"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not logged into iCloud, please log in to iCloud account"
