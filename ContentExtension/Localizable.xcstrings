    "无法确定 iCloud 账户状态，可能是网络问题": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定 iCloud 账户状态，可能是网络问题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to determine iCloud account status, possibly a network issue."
          }
        }
      }
    },
    "是否将图片保存到相册？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Photos?"
