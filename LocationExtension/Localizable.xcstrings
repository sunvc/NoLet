  "strings": {
    "iCloud 服务暂时不可用，请稍后再试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 服务暂时不可用，请稍后再试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud service is temporarily unavailable, please try again later."
          }
        }
      }
    },
    "iCloud 访问受限，可能由家长控制或 MDM 设备管理策略导致": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 访问受限，可能由家长控制或 MDM 设备管理策略导致"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud access restricted, possibly caused by parental controls or MDM device management policies"
          }
        }
      }
    },
    "iCloud 账户可用": {
